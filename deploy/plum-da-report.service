[Unit]
Description=Plum daily analytics model and static report
After=postgresql.service

[Service]
Type=oneshot
User=plum_da
EnvironmentFile=/etc/plum_da.env
EnvironmentFile=/etc/plum_da_report.env
WorkingDirectory=/opt/plum_da
ExecStart=/opt/plum_da/.venv/bin/python run_report.py --output /srv/plum_report/index.html
TimeoutStartSec=1800
UMask=0022
NoNewPrivileges=true
