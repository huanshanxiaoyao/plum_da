[Unit]
Description=Plum 数仓入库（拉取 + 装载）
# Debian/Ubuntu 的单元名是 postgresql.service（各 cluster 的元单元），
# 不是 RHEL 系的 postgresql-16.service。写错不会报错，只是这条依赖静默失效。
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=plum_da
EnvironmentFile=/etc/plum_da.env
WorkingDirectory=/opt/plum_da
ExecStart=/opt/plum_da/.venv/bin/python run_ingest.py
# 单次执行不该跑过一小时；跑超了说明卡住了，杀掉等下一轮比挂着好。
TimeoutStartSec=3000
